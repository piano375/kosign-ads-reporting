# Set these in the server environment. Never commit a real token.
# Netlify: set META_SYSTEM_TOKEN in the site environment. Local development uses the private file path.
META_SYSTEM_TOKEN=
META_SYSTEM_TOKEN_FILE=
# Required in hosted environments. The dashboard prompts for these via HTTP Basic Auth.
DASHBOARD_AUTH_USERNAME=
DASHBOARD_AUTH_PASSWORD=
META_AD_ACCOUNT_ID=act_617887027795895
META_GRAPH_API_VERSION=v21.0
META_ACCOUNT_TIMEZONE=America/Los_Angeles
META_CACHE_TTL_SECONDS=1800
REFRESH_SECRET=

# Funnel has separate credentials and remains optional until its mapping is verified.
FUNNEL_API_URL=
FUNNEL_API_TOKEN=
FUNNEL_REPORT_ID=
